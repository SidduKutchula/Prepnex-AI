# Required Environment Variables
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Optional (defaults shown)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_custom_verification_token_here

# Slack Integration (Events API + Slash Commands)
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_app_signing_secret_here
